# Copy this file to .env on the server and fill in real values.
# Never commit .env — it holds secrets.

# --- Must change for a live school ---
DJANGO_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Your website address(es), comma separated, e.g. portal.myschool.edu.pk
DJANGO_ALLOWED_HOSTS=
# Same address with https://, e.g. https://portal.myschool.edu.pk
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- School details (receipts, result cards, ID cards) ---
SCHOOL_NAME=
SCHOOL_CAMPUS=Main Campus
SCHOOL_CONTACT=

# --- Database: leave DB_ENGINE empty to use the SQLite file (fine for one school) ---
DB_ENGINE=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Optional ---
# Folder for `python manage.py backup_data` (default: ./backups)
BACKUP_DIR=
# Hours before a signed-in user is signed out (default 8)
DJANGO_SESSION_HOURS=8
# Set to false only if the hosting provider already forces HTTPS and redirects loop
DJANGO_SSL_REDIRECT=true
